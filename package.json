{
  "name": "@toneflix/vue-components",
  "description": "Collection of essential Vue Components",
  "author": "Legacy<https://github.com/3m1n3nc3>",
  "license": "MIT",
  "private": false,
  "version": "1.0.0",
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "pnpm": {
    "overrides": {
      "vue": "^3.5.43"
    }
  },
  "scripts": {
    "cypress": "cypress open",
    "build": "lerna run build",
    "watch": "lerna run watch",
    "coverage": "vitest run --coverage",
    "preview": "lerna run dev --scope=runner --",
    "lint": "pnpm run eslint && pnpm run prettier --check",
    "fmt": "pnpm run eslint && pnpm run prettier --write",
    "prettier": "prettier \"**/*.{css,html,vue,js,mjs,ts}\"",
    "eslint": "eslint . --ignore-pattern \"**/docs\"",
    "ci:publish:latest": "lerna version --conventional-commits --force-publish --yes && node scripts/publish-packages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@paystack/inline-js": "^2.25.0",
    "@toneflix/vue-shared": "workspace:^",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "cypress": "^16.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "lerna": "^10.0.1",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.3.0",
    "vue-router": "^5.3.1"
  }
}